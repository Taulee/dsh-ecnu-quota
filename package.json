{
  "name": "dsh-ecnu-quota",
  "version": "0.1.1",
  "description": "ECNU (chat.ecnu.edu.cn) quota display for the DSH web GUI: a read-only host route that proxies the ECNU quota API, plus a sidebar card and a detail panel.",
  "type": "module",
  "license": "MIT",
  "author": "Taulee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Taulee/dsh-ecnu-quota.git"
  },
  "homepage": "https://github.com/Taulee/dsh-ecnu-quota#readme",
  "bugs": "https://github.com/Taulee/dsh-ecnu-quota/issues",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "ecnu",
    "quota"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "NOTICE.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20.18"
  }
}
